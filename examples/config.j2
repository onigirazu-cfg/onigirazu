# Configuration Template
# This is a Jinja2 template for demonstration

app:
name: "{{ app_name | default('myapp') }}"
version: "{{ app_version | default('1.0.0') }}"
environment: "{{ environment | default('production') }}"

server:
host: "{{ server_host | default('localhost') }}"
port: {{ server_port | default(8080) }}

database:
host: "{{ db_host | default('localhost') }}"
port: {{ db_port | default(5432) }}
name: "{{ db_name | default('myapp') }}"

logging:
level: "{{ log_level | default('info') }}"
file: "{{ log_file | default('/var/log/app.log') }}"

features:
debug: {{ debug | default(false) | lower }}
metrics: {{ metrics | default(true) | lower }}

# Generated at: {{ onigirazu_date_time.iso8601 }}
# Host: {{ onigirazu_hostname }}
# OS: {{ onigirazu_os_family }}
