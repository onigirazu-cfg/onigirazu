{
  "hosts": [
    {
      "name": "localhost",
      "address": "127.0.0.1",
      "connection": "local"
    },
    {
      "name": "web-server-01",
      "address": "192.168.1.10",
      "port": 22,
      "user": "deploy",
      "_comment": "insecure_ignore_host_key can be set to true to disable host key verification",
      "vars": {
        "http_port": 80,
        "https_port": 443,
        "domain": "example.com"
      }
    }
  ],
  "groups": {
    "webservers": {
      "name": "webservers",
      "hosts": ["web-server-01"],
      "vars": {
        "nginx_version": "latest",
        "enable_ssl": true
      }
    },
    "production": {
      "name": "production",
      "hosts": ["web-server-01"],
      "vars": {
        "environment": "prod",
        "debug": false,
        "_comment": "Set insecure_ignore_host_key to true to disable host key verification for all hosts in this group"
      }
    },
    "all": {
      "name": "all",
      "children": ["webservers"],
      "vars": {
        "timezone": "UTC",
        "_comment": "Set insecure_ignore_host_key to true to disable host key verification for ALL hosts"
      }
    }
  }
}
