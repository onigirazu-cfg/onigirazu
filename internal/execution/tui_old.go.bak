package execution

import (
	"context"
	"fmt"
	"os"
	"strings"
	"sync"
	"time"

	tea "github.com/charmbracelet/bubbletea"
	"github.com/charmbracelet/lipgloss"
	"github.com/mattn/go-runewidth"
	"github.com/onigirazu-cfg/onigirazu/pkg/types"
	"golang.org/x/term"
)

// ImprovedTUIModel - улучшенная версия TUI с правильной архитектурой
type ImprovedTUIModel struct {
	// Основное состояние
	program *tea.Program
	ctx     context.Context
	cancel  context.CancelFunc

	// UI состояние
	width     int
	height    int
	mode      DisplayMode
	paused    bool
	showHelp  bool
	showStats bool

	// Execution состояние
	playbookName     string
	playCount        int
	currentPlayIndex int
	currentTaskName  string
	currentHost      string
	startTime        time.Time
	status           string

	// Логи и события
	logs         []LogEntry
	scrollOffset int
	maxLogs      int

	// Статистика
	taskStats map[string]*TaskStats
	hostStats map[string]*HostStats
	playStats map[string]*PlayStats

	// Синхронизация
	mutex     sync.RWMutex
	eventChan chan ExecutionEvent
	stopChan  chan struct{}

	// Callbacks
	stopCallback func() error
	playbookFunc func(context.Context) error
}

// LogEntry представляет запись в логе
type LogEntry struct {
	Timestamp time.Time
	Level     string
	Message   string
	Type      string
}

// PlayStats содержит статистику play
type PlayStats struct {
	Name      string
	Index     int
	Total     int
	Completed int
	Failed    int
	Duration  time.Duration
}

// NewImprovedTUIModel создает новый улучшенный TUI
func NewImprovedTUIModel() *ImprovedTUIModel {
	ctx, cancel := context.WithCancel(context.Background())

	return &ImprovedTUIModel{
		ctx:       ctx,
		cancel:    cancel,
		mode:      DisplayNormal,
		logs:      make([]LogEntry, 0, 1000),
		maxLogs:   1000,
		taskStats: make(map[string]*TaskStats),
		hostStats: make(map[string]*HostStats),
		playStats: make(map[string]*PlayStats),
		eventChan: make(chan ExecutionEvent, 100),
		stopChan:  make(chan struct{}),
		status:    "initializing",
		startTime: time.Now(),
	}
}

// Start запускает TUI и блокирует выполнение
func (m *ImprovedTUIModel) Start() error {
	// Проверяем, что stdin - терминал
	if !term.IsTerminal(int(os.Stdin.Fd())) {
		return fmt.Errorf("interactive mode requires a terminal")
	}

	// Создаем и запускаем bubbletea программу
	m.program = tea.NewProgram(m, tea.WithAltScreen())

	// Запускаем обработчик событий
	go m.eventProcessor()

	// Запускаем TUI (блокирующий вызов)
	if _, err := m.program.Run(); err != nil {
		return fmt.Errorf("TUI error: %w", err)
	}

	return nil
}

// Stop останавливает TUI
func (m *ImprovedTUIModel) Stop() {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	if m.cancel != nil {
		m.cancel()
	}

	close(m.stopChan)

	if m.program != nil {
		m.program.Quit()
	}
}

// Init инициализирует модель
func (m *ImprovedTUIModel) Init() tea.Cmd {
	return tea.Batch(
		m.listenForEvents(),
		tea.EnterAltScreen,
	)
}

// Update обрабатывает сообщения
func (m *ImprovedTUIModel) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	switch msg := msg.(type) {
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
		return m, nil

	case tea.KeyMsg:
		return m.handleKeypress(msg)

	case ExecutionEvent:
		m.processEvent(msg)
		return m, m.listenForEvents()

	case tea.QuitMsg:
		return m, tea.Quit
	}

	return m, nil
}

// View рендерит интерфейс
func (m *ImprovedTUIModel) View() string {
	m.mutex.RLock()
	defer m.mutex.RUnlock()

	if m.showHelp {
		return m.renderHelp()
	}

	if m.showStats {
		return m.renderStats()
	}

	return m.renderMain()
}

// handleKeypress обрабатывает нажатия клавиш
func (m *ImprovedTUIModel) handleKeypress(msg tea.KeyMsg) (tea.Model, tea.Cmd) {
	switch msg.String() {
	case "ctrl+c", "q":
		return m, tea.Quit

	case "v":
		m.toggleMode(DisplayVerbose)

	case "d":
		m.toggleMode(DisplayDebug)

	case "n":
		m.setMode(DisplayNormal)

	case "p":
		m.togglePause()

	case "s":
		m.toggleStats()

	case "h":
		m.toggleHelp()

	case "g":
		m.gracefulStop()

	case "up":
		m.scrollUp()

	case "down":
		m.scrollDown()

	case "pageup":
		m.scrollPageUp()

	case "pagedown":
		m.scrollPageDown()
	}

	return m, nil
}

// toggleMode переключает режим отображения
func (m *ImprovedTUIModel) toggleMode(newMode DisplayMode) {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	if m.mode == newMode {
		m.mode = DisplayNormal
	} else {
		m.mode = newMode
	}

	m.addLog(LogEntry{
		Timestamp: time.Now(),
		Level:     "INFO",
		Message:   fmt.Sprintf("Mode changed to: %s", m.getModeName()),
		Type:      "mode_change",
	})
}

// setMode устанавливает режим отображения
func (m *ImprovedTUIModel) setMode(mode DisplayMode) {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	if m.mode != mode {
		m.mode = mode
		m.addLog(LogEntry{
			Timestamp: time.Now(),
			Level:     "INFO",
			Message:   fmt.Sprintf("Mode changed to: %s", m.getModeName()),
			Type:      "mode_change",
		})
	}
}

// togglePause переключает паузу
func (m *ImprovedTUIModel) togglePause() {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	m.paused = !m.paused
	status := "PAUSED"
	if !m.paused {
		status = "RESUMED"
	}

	m.addLog(LogEntry{
		Timestamp: time.Now(),
		Level:     "INFO",
		Message:   fmt.Sprintf("Execution %s", status),
		Type:      "pause_toggle",
	})
}

// toggleStats переключает отображение статистики
func (m *ImprovedTUIModel) toggleStats() {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	m.showStats = !m.showStats
}

// toggleHelp переключает отображение справки
func (m *ImprovedTUIModel) toggleHelp() {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	m.showHelp = !m.showHelp
}

// gracefulStop выполняет graceful остановку
func (m *ImprovedTUIModel) gracefulStop() {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	m.addLog(LogEntry{
		Timestamp: time.Now(),
		Level:     "INFO",
		Message:   "Gracefully stopping execution...",
		Type:      "graceful_stop",
	})

	if m.stopCallback != nil {
		go func() {
			if err := m.stopCallback(); err != nil {
				m.addLog(LogEntry{
					Timestamp: time.Now(),
					Level:     "ERROR",
					Message:   fmt.Sprintf("Error stopping: %v", err),
					Type:      "error",
				})
			}
		}()
	}
}

// scrollUp прокручивает вверх
func (m *ImprovedTUIModel) scrollUp() {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	if m.scrollOffset > 0 {
		m.scrollOffset--
	}
}

// scrollDown прокручивает вниз
func (m *ImprovedTUIModel) scrollDown() {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	maxScroll := len(m.logs) - m.height + 4 // +4 для заголовков
	if maxScroll > 0 && m.scrollOffset < maxScroll {
		m.scrollOffset++
	}
}

// scrollPageUp прокручивает на страницу вверх
func (m *ImprovedTUIModel) scrollPageUp() {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	m.scrollOffset -= m.height - 4
	if m.scrollOffset < 0 {
		m.scrollOffset = 0
	}
}

// scrollPageDown прокручивает на страницу вниз
func (m *ImprovedTUIModel) scrollPageDown() {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	maxScroll := len(m.logs) - m.height + 4
	if maxScroll > 0 {
		m.scrollOffset += m.height - 4
		if m.scrollOffset > maxScroll {
			m.scrollOffset = maxScroll
		}
	}
}

// getModeName возвращает название текущего режима
func (m *ImprovedTUIModel) getModeName() string {
	switch m.mode {
	case DisplayVerbose:
		return "VERBOSE"
	case DisplayDebug:
		return "DEBUG"
	default:
		return "NORMAL"
	}
}

// addLog добавляет запись в лог
func (m *ImprovedTUIModel) addLog(entry LogEntry) {
	m.logs = append(m.logs, entry)

	// Ограничиваем количество логов
	if len(m.logs) > m.maxLogs {
		m.logs = m.logs[len(m.logs)-m.maxLogs:]
	}

	// Автоскролл к концу
	maxScroll := len(m.logs) - m.height + 4
	if maxScroll > 0 {
		m.scrollOffset = maxScroll
	}
}

// processEvent обрабатывает событие выполнения
func (m *ImprovedTUIModel) processEvent(event ExecutionEvent) {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	// Определяем, нужно ли отображать событие
	shouldDisplay := m.shouldDisplayEvent(event)
	if !shouldDisplay {
		return
	}

	// Создаем запись лога
	entry := LogEntry{
		Timestamp: event.Timestamp,
		Level:     m.getEventLevel(event),
		Message:   m.formatEventMessage(event),
		Type:      event.Type,
	}

	m.addLog(entry)

	// Обновляем состояние
	m.updateStateFromEvent(event)
}

// shouldDisplayEvent определяет, нужно ли отображать событие
func (m *ImprovedTUIModel) shouldDisplayEvent(event ExecutionEvent) bool {
	switch m.mode {
	case DisplayNormal:
		return event.Type == "error" || event.Type == "execution_end" || event.Type == "play_start"
	case DisplayVerbose:
		return event.Type != "task_start" || m.mode == DisplayDebug
	case DisplayDebug:
		return true
	default:
		return false
	}
}

// getEventLevel возвращает уровень события
func (m *ImprovedTUIModel) getEventLevel(event ExecutionEvent) string {
	switch event.Type {
	case "error":
		return "ERROR"
	case "execution_start", "play_start":
		return "INFO"
	case "task_start", "task_end":
		return "DEBUG"
	default:
		return "INFO"
	}
}

// formatEventMessage форматирует сообщение события
func (m *ImprovedTUIModel) formatEventMessage(event ExecutionEvent) string {
	switch event.Type {
	case "execution_start":
		return fmt.Sprintf("▶ Starting: %s", event.Message)
	case "play_start":
		return fmt.Sprintf("▶ Play [%d/%d]: %s", m.currentPlayIndex, m.playCount, event.PlayName)
	case "play_end":
		return fmt.Sprintf("✓ Play completed: %s", event.PlayName)
	case "task_start":
		return fmt.Sprintf("⟳ Task: %s on %s", event.TaskName, event.HostName)
	case "task_end":
		return fmt.Sprintf("✓ Task: %s on %s", event.TaskName, event.HostName)
	case "error":
		return fmt.Sprintf("✗ ERROR: %s", event.Message)
	case "execution_end":
		return fmt.Sprintf("▶ Execution ended: %s", event.Message)
	default:
		return event.Message
	}
}

// updateStateFromEvent обновляет состояние на основе события
func (m *ImprovedTUIModel) updateStateFromEvent(event ExecutionEvent) {
	switch event.Type {
	case "execution_start":
		m.status = "running"
	case "play_start":
		m.currentPlayIndex = event.PlayIndex
		m.currentTaskName = ""
	case "task_start":
		m.currentTaskName = event.TaskName
		m.currentHost = event.HostName
	case "execution_end":
		m.status = "completed"
	}
}

// eventProcessor обрабатывает события в отдельной горутине
func (m *ImprovedTUIModel) eventProcessor() {
	for {
		select {
		case event := <-m.eventChan:
			// Отправляем событие в основной поток
			m.program.Send(event)
		case <-m.ctx.Done():
			return
		}
	}
}

// listenForEvents слушает события
func (m *ImprovedTUIModel) listenForEvents() tea.Cmd {
	return func() tea.Msg {
		select {
		case event := <-m.eventChan:
			return event
		case <-m.ctx.Done():
			return tea.Quit()
		}
	}
}

// renderMain рендерит основной интерфейс
func (m *ImprovedTUIModel) renderMain() string {
	var sb strings.Builder

	// Статус бар
	sb.WriteString(m.renderStatusBar())
	sb.WriteString("\n")

	// Область логов
	sb.WriteString(m.renderLogArea())
	sb.WriteString("\n")

	// Панель управления
	sb.WriteString(m.renderControlBar())

	return sb.String()
}

// renderStatusBar рендерит статус бар
func (m *ImprovedTUIModel) renderStatusBar() string {
	statusStyle := lipgloss.NewStyle().
		Background(lipgloss.Color("239")).
		Foreground(lipgloss.Color("255")).
		Padding(0, 1).
		Width(m.width)

	duration := time.Since(m.startTime).Round(time.Second)
	pausedStr := ""
	if m.paused {
		pausedStr = " [PAUSED]"
	}

	statusText := fmt.Sprintf(
		"🍙 %s | Play: %d/%d | Task: %s | Mode: %s | %v%s",
		m.playbookName,
		m.currentPlayIndex,
		m.playCount,
		truncateString(m.currentTaskName, 30),
		m.getModeName(),
		duration,
		pausedStr,
	)

	// Обрезаем если слишком длинный
	if m.width > 20 {
		statusText = runewidth.Truncate(statusText, m.width-2, "")
	}

	return statusStyle.Render(statusText)
}

// renderLogArea рендерит область логов
func (m *ImprovedTUIModel) renderLogArea() string {
	startIdx := m.scrollOffset
	endIdx := startIdx + m.height - 4 // -4 для заголовков

	if endIdx > len(m.logs) {
		endIdx = len(m.logs)
	}

	var visibleLogs []LogEntry
	if startIdx < len(m.logs) {
		visibleLogs = m.logs[startIdx:endIdx]
	}

	// Заполняем до нужной высоты
	for len(visibleLogs) < m.height-4 {
		visibleLogs = append(visibleLogs, LogEntry{})
	}

	var lines []string
	for _, entry := range visibleLogs {
		if entry.Timestamp.IsZero() {
			lines = append(lines, "")
		} else {
			timeStr := entry.Timestamp.Format("15:04:05")
			line := fmt.Sprintf("[%s] %s %s", timeStr, entry.Level, entry.Message)

			// Обрезаем по ширине
			if m.width > 10 {
				line = runewidth.Truncate(line, m.width-2, "")
			}

			lines = append(lines, line)
		}
	}

	return strings.Join(lines, "\n")
}

// renderControlBar рендерит панель управления
func (m *ImprovedTUIModel) renderControlBar() string {
	controlStyle := lipgloss.NewStyle().
		Background(lipgloss.Color("236")).
		Foreground(lipgloss.Color("244")).
		Padding(0, 1).
		Width(m.width)

	var controlText string
	if m.width > 80 {
		controlText = "V:Verbose  D:Debug  N:Normal  P:Pause  S:Stats  G:Stop  H:Help  Q:Quit  | ↑↓/PgUp/PgDn: Scroll"
	} else if m.width > 60 {
		controlText = "V:Verbose  D:Debug  N:Normal  S:Stats  G:Stop  H:Help  Q:Quit | Scroll: ↑↓/PgUp/PgDn"
	} else if m.width > 40 {
		controlText = "V:Verbose  D:Debug  N:Normal  S:Stats  H:Help  Q:Quit"
	} else {
		controlText = "V:Verb  D:Dbg  N:Norm  S:Stats  Q:Quit"
	}

	return controlStyle.Render(controlText)
}

// renderHelp рендерит справку
func (m *ImprovedTUIModel) renderHelp() string {
	// Реализация справки (аналогично существующей)
	return m.renderModalOverlay(m.renderHelpOverlay())
}

// renderStats рендерит статистику
func (m *ImprovedTUIModel) renderStats() string {
	// Реализация статистики (аналогично существующей)
	return m.renderModalOverlay(m.renderStatsOverlay())
}

// renderModalOverlay рендерит модальное окно
func (m *ImprovedTUIModel) renderModalOverlay(content string) string {
	// Центрируем контент с бордером
	borderStyle := lipgloss.NewStyle().
		Foreground(lipgloss.Color("33")).
		Border(lipgloss.RoundedBorder()).
		Padding(1, 2).
		MaxWidth(m.width - 4)

	// Форматируем с разделителями для лучшего вида
	formatted := strings.TrimSpace(content)
	return lipgloss.NewStyle().
		Width(m.width).
		Height(m.height).
		Align(lipgloss.Center, lipgloss.Center).
		Render(borderStyle.Render(formatted))
}

// renderHelpOverlay рендерит справку
func (m *ImprovedTUIModel) renderHelpOverlay() string {
	helpText := `
╔══════════════════════════════════════════════════════════════════╗
║                    🎮 INTERACTIVE MODE HELP 🎮                   ║
╠══════════════════════════════════════════════════════════════════╣
║                                                                  ║
║  DISPLAY MODES                                                   ║
║  V  - Toggle Verbose mode (show more details)                   ║
║  D  - Toggle Debug mode (show all events)                       ║
║  N  - Switch to Normal mode (minimal output)                    ║
║                                                                  ║
║  EXECUTION CONTROL                                               ║
║  P  - Pause / Resume execution                                  ║
║  G  - Graceful stop (finish current task)                       ║
║  Q / Ctrl+C - Quit interactive mode                             ║
║                                                                  ║
║  VIEW & STATS                                                    ║
║  S  - Toggle statistics overlay                                 ║
║  H  - Toggle this help overlay                                  ║
║                                                                  ║
║  NAVIGATION                                                      ║
║  ↑ / ↓   - Scroll up/down through logs                          ║
║  PgUp / PgDn - Page scroll                                      ║
║                                                                  ║
║  LEGEND                                                          ║
║  ▶  - Running / Started                                         ║
║  ✓  - Completed / Success                                       ║
║  ✗  - Failed / Error                                            ║
║  ⟳  - Changed / In progress                                     ║
║                                                                  ║
║  Press 'H' to close this help window                            ║
║                                                                  ║
╚══════════════════════════════════════════════════════════════════╝
`
	return strings.TrimSpace(helpText)
}

// renderStatsOverlay рендерит статистику
func (m *ImprovedTUIModel) renderStatsOverlay() string {
	// Безопасное чтение статистики
	m.mutex.RLock()
	playName := m.playbookName
	playIndex := m.currentPlayIndex
	playCount := m.playCount
	currentTask := m.currentTaskName
	currentHost := m.currentHost
	status := m.status
	startTime := m.startTime
	m.mutex.RUnlock()

	// Вычисляем прошедшее время
	elapsed := time.Since(startTime).Round(time.Second)

	// Считаем статистику
	totalTasks := len(m.taskStats)
	totalHosts := len(m.hostStats)

	statsText := fmt.Sprintf(`
╔════════════════════════════════════════════════════════════╗
║                  📊 EXECUTION STATISTICS 📊               ║
╠════════════════════════════════════════════════════════════╣
║                                                            ║
║  EXECUTION STATUS                                          ║
║  Playbook: %s
║  Status:   %s
║  Elapsed:  %v
║                                                            ║
║  PROGRESS                                                  ║
║  Plays:    %d / %d
║  Current:  %s
║  Host:     %s
║                                                            ║
║  STATISTICS                                                ║
║  Total Tasks:  %d
║  Total Hosts:  %d
║                                                            ║
║  Press 'S' to close statistics                            ║
║                                                            ║
╚════════════════════════════════════════════════════════════╝
`,
		truncateString(playName, 40),
		strings.ToUpper(status),
		elapsed,
		playIndex,
		playCount,
		truncateString(currentTask, 40),
		truncateString(currentHost, 40),
		totalTasks,
		totalHosts,
	)

	return strings.TrimSpace(statsText)
}

// SetStopCallback устанавливает callback для остановки
func (m *ImprovedTUIModel) SetStopCallback(fn func() error) {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	m.stopCallback = fn
}

// AddEvent добавляет событие
func (m *ImprovedTUIModel) AddEvent(event ExecutionEvent) {
	select {
	case m.eventChan <- event:
	default:
		// Канал полный, пропускаем событие
	}
}

// Реализация интерфейса ExecutionObserver

// OnExecutionStart вызывается при начале выполнения
func (m *ImprovedTUIModel) OnExecutionStart(playbookName string, playCount int) {
	m.mutex.Lock()
	m.playbookName = playbookName
	m.playCount = playCount
	m.startTime = time.Now()
	m.mutex.Unlock()

	m.AddEvent(ExecutionEvent{
		Type:      "execution_start",
		Message:   fmt.Sprintf("Starting execution of %s (%d plays)", playbookName, playCount),
		Timestamp: time.Now(),
	})
}

// OnPlayStart вызывается при начале play
func (m *ImprovedTUIModel) OnPlayStart(playName string, playIndex int, totalPlays int) {
	m.mutex.Lock()
	m.currentPlayIndex = playIndex
	m.mutex.Unlock()

	m.AddEvent(ExecutionEvent{
		Type:      "play_start",
		PlayName:  playName,
		PlayIndex: playIndex,
		Message:   fmt.Sprintf("Starting play: %s", playName),
		Timestamp: time.Now(),
	})
}

// OnPlayEnd вызывается при завершении play
func (m *ImprovedTUIModel) OnPlayEnd(playName string, playIndex int, success bool, duration time.Duration) {
	status := "✓"
	if !success {
		status = "✗"
	}

	m.AddEvent(ExecutionEvent{
		Type:      "play_end",
		PlayName:  playName,
		Message:   fmt.Sprintf("%s Play %s completed in %v", status, playName, duration.Round(time.Millisecond)),
		Timestamp: time.Now(),
	})
}

// OnTaskStart вызывается при начале задачи
func (m *ImprovedTUIModel) OnTaskStart(taskName string, hostName string) {
	m.AddEvent(ExecutionEvent{
		Type:      "task_start",
		TaskName:  taskName,
		HostName:  hostName,
		Message:   fmt.Sprintf("Running task '%s' on %s", taskName, hostName),
		Timestamp: time.Now(),
	})
}

// OnTaskEnd вызывается при завершении задачи
func (m *ImprovedTUIModel) OnTaskEnd(taskResult *types.TaskResult) {
	if taskResult == nil {
		return
	}

	status := "✓"
	if taskResult.Failed {
		status = "✗"
	} else if taskResult.Changed {
		status = "⟳"
	}

	m.AddEvent(ExecutionEvent{
		Type:      "task_end",
		TaskName:  taskResult.TaskName,
		HostName:  taskResult.Host,
		Message:   fmt.Sprintf("%s Task '%s' on %s", status, taskResult.TaskName, taskResult.Host),
		Timestamp: time.Now(),
	})
}

// OnExecutionEnd вызывается при завершении выполнения
func (m *ImprovedTUIModel) OnExecutionEnd(result *types.PlaybookResult, duration time.Duration) {
	status := "✓ success"
	if result.Failed {
		status = "✗ failed"
	}

	m.mutex.Lock()
	m.status = "completed"
	if result.Failed {
		m.status = "failed"
	}
	m.mutex.Unlock()

	m.AddEvent(ExecutionEvent{
		Type:      "execution_end",
		Message:   fmt.Sprintf("Execution completed: %s (%v)", status, duration.Round(time.Millisecond)),
		Timestamp: time.Now(),
	})
}

// OnError вызывается при ошибке
func (m *ImprovedTUIModel) OnError(taskName string, hostName string, error string) {
	m.AddEvent(ExecutionEvent{
		Type:      "error",
		TaskName:  taskName,
		HostName:  hostName,
		Message:   fmt.Sprintf("Error in %s on %s: %s", taskName, hostName, error),
		Timestamp: time.Now(),
	})
}

// truncateString обрезает строку
func truncateString(s string, maxLen int) string {
	if len(s) <= maxLen {
		return s
	}
	return s[:maxLen-3] + "..."
}

// SetPlaybookExecutor устанавливает функцию выполнения playbook
func (m *ImprovedTUIModel) SetPlaybookExecutor(fn func(context.Context) error) {
	m.mutex.Lock()
	defer m.mutex.Unlock()

	m.playbookFunc = fn
}

// RunWithPlaybook запускает TUI с функцией playbook в отдельной горутине
func (m *ImprovedTUIModel) RunWithPlaybook(fn func(context.Context) error) error {
	m.SetPlaybookExecutor(fn)

	// Запускаем playbook в отдельной горутине
	go func() {
		if err := fn(m.ctx); err != nil {
			m.AddEvent(ExecutionEvent{
				Type:      "error",
				Message:   fmt.Sprintf("Execution error: %v", err),
				Timestamp: time.Now(),
			})
		}
	}()

	// Запускаем TUI (блокирующий вызов)
	return m.Start()
}
